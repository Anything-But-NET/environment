Table core.document_metadata {
  document_id varchar(255) [pk, not null]
  source_system varchar(100)
  title text
  url text
  last_updated timestamptz
  last_sync_at timestamptz [not null]
}

Enum core.sync_status {
  IN_PROGRESS
  COMPLETED
  FAILED_FETCH
  FAILED_PARSE
  FAILED_STORAGE
}

Enum core.dashboard_operator_authority {
  LOGS
  METADATA
  USERS
  OPERATORS
  ANALYTICS
  PROMPTS
  ESCALATIONS
}

Enum core.dashboard_operator_status {
  ACTIVE
  BLOCKED
}

Table core.dashboard_operators {
  id uuid [pk]
  email varchar(255) [not null, unique]
  authorities "core.dashboard_operator_authority[]" [not null, default: '{}']
  password_hash text [not null]
  status core.dashboard_operator_status [not null, default: 'ACTIVE']
  last_refreshed_at timestamptz [not null, default: `now()`]
  last_updated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
}

Table core.document_sync_runs {
  id uuid [pk]
  document_id varchar(255) [not null]
  status core.sync_status [not null, default: 'IN_PROGRESS']
  error_message text
  started_at timestamptz [not null]
  finished_at timestamptz

  indexes {
    document_id [name: 'idx_sync_runs_doc_id']
  }
}

Enum core.chat_channel {
  SLACK
  TEAMS
}

Enum core.generation_outcome {
  ANSWERED
  SAFE_NO_ANSWER
  ESCALATED
  FAILURE
}

Enum core.question_outcome_reason_code {
  LOW_CONFIDENCE
  EMPTY_RETRIEVAL
}

Enum core.error_category {
  VALIDATION_ERROR
  RETRIEVAL_TIMEOUT
  VECTOR_DB_UNAVAILABLE
  LLM_PROVIDER_ERROR
  INTERNAL_ERROR
  INTERNAL_CONNECTION_ERROR
}

Table core.generation_diagnostics {
  id uuid [pk]
  query_id varchar(255) [not null, unique]
  channel core.chat_channel [not null, default: 'SLACK']
  outcome core.generation_outcome [not null]
  reason_code core.question_outcome_reason_code
  error_category core.error_category
  confidence_score float
  latency_ms integer
  prompt_version_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    created_at [name: 'idx_gen_diag_created_at']
    outcome [name: 'idx_gen_diag_outcome']
    channel [name: 'idx_gen_diag_channel']
  }
}

Enum core.escalation_status {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

Table core.escalations {
  id uuid [pk]
  query_id varchar(255) [not null, unique]
  requester_email varchar(255) [not null]
  question_text text [not null]
  source_references jsonb [not null, default: '[]']
  status core.escalation_status [not null, default: 'PENDING']
  resolution_id uuid [unique]
  resolution_text text
  resolution_updated_at timestamptz
  resolved_by_operator_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz

  indexes {
    status [name: 'idx_escalations_status']
    created_at [name: 'idx_escalations_created_at']
  }
}

Table core.escalation_status_history {
  id uuid [pk]
  escalation_id uuid [not null]
  from_status core.escalation_status
  to_status core.escalation_status [not null]
  changed_by_operator_id uuid
  changed_at timestamptz [not null, default: `now()`]

  indexes {
    escalation_id [name: 'idx_esc_history_escalation_id']
    changed_at [name: 'idx_esc_history_changed_at']
  }
}

Ref: core.escalations.query_id - core.generation_diagnostics.query_id [delete: restrict]
Ref: core.escalations.resolved_by_operator_id > core.dashboard_operators.id [delete: set null]
Ref: core.escalation_status_history.escalation_id > core.escalations.id [delete: cascade]
Ref: core.escalation_status_history.changed_by_operator_id > core.dashboard_operators.id [delete: set null]

Table core.escalation_drafts {
  query_id varchar(255) [pk]
  requester_email varchar(255) [not null]
  question_text text [not null]
  source_references jsonb [not null, default: '[]']
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]

  indexes {
    expires_at [name: 'idx_esc_drafts_expires_at']
  }
}

Table core.users {
  email varchar(255) [pk]
  allowed_groups "text[]" [not null, default: '{}']
  last_updated timestamptz
  last_sync_at timestamptz [not null]
}

Table rag.chunks {
  id uuid [pk]
  text text [not null]
  document_id varchar(255) [not null]

  indexes {
    document_id [name: 'chunk_doc_id']
  }
}

Table rag.vector_nodes {
  id uuid [pk]
  parent_id uuid
  children_count integer [not null, default: 0]
  embedding vector(1024) [not null] // Тип pgvector
  document_id varchar(255) [not null]

  indexes {
    embedding [name: 'embedding_idx', type: hnsw] // postgresql_ops: vector_cosine_ops
  }
}

Table rag.document {
  document_id varchar(255) [pk]
  allowed_groups "text[]" [not null, default: '{}']
  last_updated timestamptz
  last_sync_at timestamptz [not null]

  indexes {
    allowed_groups [type: gin, name: 'idx_document_metadata_allowed_groups']
  }
}

Table rag.vector_chunk_association {
  vector_node_id uuid
  chunk_id uuid
  position integer [not null, default: 0]

  indexes {
    (vector_node_id, chunk_id) [pk]
    chunk_id [name: 'idx_vca_chunk_id']
  }
}

Ref: rag.vector_nodes.parent_id > rag.vector_nodes.id [delete: set null]
Ref: rag.vector_nodes.document_id > rag.document.document_id [delete: cascade]
Ref: rag.chunks.document_id > rag.document.document_id [delete: cascade]
Ref: rag.vector_chunk_association.vector_node_id > rag.vector_nodes.id [delete: cascade]
Ref: rag.vector_chunk_association.chunk_id > rag.chunks.id [delete: cascade]

Table rag.prompt_versions {
  id uuid [pk]
  prompt_text text [not null]
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
}

Table rag.evaluation_runs {
  id uuid [pk]
  prompt_version_id uuid [not null, ref: > rag.prompt_versions.id]
  status varchar [not null, default: 'pending']
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
}
