meta {
  name: Get File Metadata - Alice (expect 200)
  type: http
  seq: 8
}

get {
  url: {{mockGraphBaseUrl}}/v1.0/drives/{{driveId}}/root:/Engineering/Backend/db-migrations.md:?$select=id,name,size,file
  body: none
  auth: none
}

headers {
  Authorization: Bearer user:alice
}

assert {
  res.status: eq 200
  res.body.name: eq db-migrations.md
}

docs {
  Returns metadata for db-migrations.md for authorized user Alice.
}
