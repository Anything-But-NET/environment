meta {
  name: List Users - App Token (expect 200)
  type: http
  seq: 3
}

get {
  url: {{mockGraphBaseUrl}}/v1.0/users?$select=id,displayName,userPrincipalName&$top=5
  body: none
  auth: none
}

headers {
  Authorization: Bearer app
}

assert {
  res.status: eq 200
  res.body.value: isDefined
}

docs {
  Lists users in directory using app token.
}
