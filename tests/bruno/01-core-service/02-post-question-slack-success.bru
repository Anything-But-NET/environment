meta {
  name: Post Question (Slack) - Success (expect 200)
  type: http
  seq: 2
}

post {
  url: {{coreBaseUrl}}/api/v1/chat/question
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "query_id": "req-123",
    "channel": "slack",
    "user_email": "oleh.pona@company.com",
    "query": "How to get internet compensation?"
  }
}

assert {
  res.status: eq 200
  res.body.query_id: eq req-123
  res.body.status: isDefined
  res.body.reply_text: isDefined
  res.body.citations: isDefined
}

docs {
  Forward user question from Slack to Core service.
  Expects 200 OK with UserQuestionResponse.
}
