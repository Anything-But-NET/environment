meta {
  name: Generate Answer - Missing User Permissions (expect 400 or 422)
  type: http
  seq: 4
}

post {
  url: {{ragBaseUrl}}/api/v1/rag/generate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "query_id": "req-rag-live-err-03",
    "query": "Valid query"
  }
}

assert {
  res.status: in [400, 422]
  res.body.status: eq VALIDATION_ERROR
}

docs {
  Validates that omitting user_permissions returns validation error.
}
